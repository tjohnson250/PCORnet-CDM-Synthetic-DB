                                        paste(sample(letters, sample(3:8, 1)), collapse = ""))),
  M = sample_with_na(LETTERS, N_PATIENTS, prob_na = 0.3, replace = TRUE),
  Last = replicate(N_PATIENTS, paste0(sample(LETTERS, 1), 
                                       paste(sample(letters, sample(4:10, 1)), collapse = ""))),
